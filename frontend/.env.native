# 原生殼(Tauri 桌面 / Capacitor 手機)建置環境:npm run build:native(vite build --mode native)
# 詳見 docs/NATIVE-CLIENTS.md §3。
VITE_PLATFORM=native
# 必須 off:否則伺服器連不上時會靜默改用 mock 假資料
VITE_MOCK=off
# 首次啟動預填的伺服器(使用者可在 App 內更換)
VITE_DEFAULT_SERVER=https://kf.56k.cc
# Android 推播:CI 有注入 google-services.json 時才改成 on(沒有 Firebase 設定時呼叫 register 會原生閃退)
VITE_FCM_ENABLED=off
